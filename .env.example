# 复制为 .env 后修改。不要把真实密码提交到 Git。
FATHER_PASSWORD=qwe123
MOTHER_PASSWORD=111111
GRANDFATHER_PASSWORD=111111
GRANDMOTHER_PASSWORD=111111
SESSION_SECRET=请换成至少32位且无法猜测的随机字符串
# 仅允许本机反向代理访问时可改为 127.0.0.1；家庭局域网访问保持 0.0.0.0。
BIND_ADDRESS=0.0.0.0
# Unraid 家庭局域网访问端口。
HOST_PORT=5937
# 本地开发可保持 ./data；Unraid 推荐 /mnt/user/appdata/baby-care/data。
DATA_DIR=./data
# 通过 HTTPS 域名访问时改为 true；仅局域网 HTTP 调试保持 false。
COOKIE_SECURE=false

# 可选：配置后启用 AI 语音转写。密钥只保存在服务器端。
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

PUSH_ENABLED=false
